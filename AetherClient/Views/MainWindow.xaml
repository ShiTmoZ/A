<Window x:Class="AetherClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AetherClient.Models"
        mc:Ignorable="d"
        Title="Aether MASQUE Client"
        Width="450"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="Transparent"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="24"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Liquid Glass Meniscus Specular Brushes -->
        <LinearGradientBrush x:Key="MeniscusEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E6FFFFFF" Offset="0.0" />
            <GradientStop Color="#60FFFFFF" Offset="0.3" />
            <GradientStop Color="#18FFFFFF" Offset="0.7" />
            <GradientStop Color="#00000000" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassTileEdgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A0FFFFFF" Offset="0.0" />
            <GradientStop Color="#30FFFFFF" Offset="0.4" />
            <GradientStop Color="#0DFFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WindowGlassSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D80C1424" Offset="0.0" />
            <GradientStop Color="#E8070C16" Offset="0.5" />
            <GradientStop Color="#F2040710" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TileGlassSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#28FFFFFF" Offset="0.0" />
            <GradientStop Color="#0AFFFFFF" Offset="0.5" />
            <GradientStop Color="#121828" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ActionPlateSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3AFFFFFF" Offset="0.0" />
            <GradientStop Color="#12FFFFFF" Offset="0.45" />
            <GradientStop Color="#18233A" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Accent Colors -->
        <SolidColorBrush x:Key="AccentIce" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981" />
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="TextMuted" Color="#7A8CA3" />
        <SolidColorBrush x:Key="TextSub" Color="#A4B3C6" />

        <!-- Circular Glass Chrome Window Control Buttons -->
        <Style x:Key="GlassChromeBtn" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="Foreground" Value="#C2D2E8" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#38FFFFFF" />
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="#80FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassChromeCloseBtn" TargetType="Button" BasedOn="{StaticResource GlassChromeBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="#80EF4444" />
                                <Setter TargetName="BtnBd" Property="BorderBrush" Value="#FF9999" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Liquid Switch RadioButton -->
        <Style x:Key="LiquidSegmentRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7A8CA3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                CornerRadius="10"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBd" Property="Background" Value="#15FFFFFF" />
                                <Setter Property="Foreground" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#40FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#18FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#253555" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PillBd" Property="BorderBrush" Value="{StaticResource GlassTileEdgeBrush}" />
                                <Setter TargetName="PillBd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#38BDF8" BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Action Plate Button Style -->
        <Style x:Key="GlassActionPlateBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource ActionPlateSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource MeniscusEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PlateBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="18,12">
                            <Border.Effect>
                                <DropShadowEffect
                                                  Color="#38BDF8"
                                                  BlurRadius="28"
                                                  ShadowDepth="6"
                                                  Opacity="0.25"
                                                  Direction="270" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PlateBd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#55FFFFFF" Offset="0.0" />
                                            <GradientStop Color="#22FFFFFF" Offset="0.45" />
                                            <GradientStop Color="#223350" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PlateBd" Property="BorderBrush" Value="#FFFFFFFF" />
                                <Setter TargetName="PlateBd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#38BDF8" BlurRadius="36" ShadowDepth="6" Opacity="0.45" Direction="270" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PlateBd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985" CenterX="150" CenterY="30" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Hunting}">
                                <Setter TargetName="PlateBd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F59E0B" BlurRadius="36" ShadowDepth="6" Opacity="0.55" Direction="270" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Connected}">
                                <Setter TargetName="PlateBd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#10B981" BlurRadius="36" ShadowDepth="6" Opacity="0.55" Direction="270" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mini Action Pill Button (Copy/Clear) -->
        <Style x:Key="MiniPillBtn" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#35FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#A4B3C6" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MiniBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MiniBd" Property="Background" Value="#35FFFFFF" />
                                <Setter TargetName="MiniBd" Property="BorderBrush" Value="#70FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Master Liquid Glass Shell (Outer Window Frame) -->
    <Border Margin="8"
            CornerRadius="24"
            Background="{StaticResource WindowGlassSurface}"
            BorderBrush="{StaticResource MeniscusEdgeBrush}"
            BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect Color="#38BDF8" BlurRadius="34" ShadowDepth="8" Opacity="0.22" Direction="270" />
        </Border.Effect>

        <Grid Margin="16,14,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- 0: Header & Controls -->
                <RowDefinition Height="Auto" />  <!-- 1: Telemetry Grid -->
                <RowDefinition Height="Auto" />  <!-- 2: Primary Liquid Action Plate -->
                <RowDefinition Height="Auto" />  <!-- 3: Segmented Routing Switch & Strategy -->
                <RowDefinition Height="*" />     <!-- 4: Collapsible Logs HUD -->
            </Grid.RowDefinitions>

            <!-- 0. Header Chrome -->
            <Grid Grid.Row="0" Margin="2,0,2,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Group -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Optical Sapphire Lens Gem -->
                    <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#38BDF8" />
                                <Setter Property="BorderBrush" Value="#FFFFFF" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#38BDF8" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Hunting}">
                                        <Setter Property="Background" Value="#F59E0B" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#F59E0B" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Connected}">
                                        <Setter Property="Background" Value="#10B981" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#10B981" BlurRadius="14" ShadowDepth="0" Opacity="0.9" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <TextBlock Text="AETHER"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="13.5"
                               FontWeight="Heavy"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center" />

                    <!-- Protocol Capsule Badge -->
                    <Border Margin="10,0,0,0"
                            Padding="8,2"
                            CornerRadius="999"
                            Background="#18FFFFFF"
                            BorderBrush="#38FFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="MASQUE // H2"
                                   FontFamily="Cascadia Code, Consolas"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#C2D2E8" />
                    </Border>
                </StackPanel>

                <!-- Window Control Buttons (Minimize / Close) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GlassChromeBtn}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize to Taskbar"
                            Margin="0,0,6,0">
                        <Path Data="M 0 0 L 8 0" Stroke="#C2D2E8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>

                    <Button Style="{StaticResource GlassChromeCloseBtn}"
                            Click="HideToTrayButton_Click"
                            ToolTip="Close (Hide to System Tray)">
                        <Path Data="M 0 0 L 8 8 M 0 8 L 8 0" Stroke="#C2D2E8" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 1. Stabilized Telemetry Cards (SetProduct Scrim Glass Stack) -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tile 1: Gateway Peer IP -->
                <Border Grid.Column="0"
                        CornerRadius="14"
                        Background="{StaticResource TileGlassSurface}"
                        BorderBrush="{StaticResource GlassTileEdgeBrush}"
                        BorderThickness="1"
                        Padding="11,9">
                    <StackPanel>
                        <TextBlock Text="GATEWAY PEER" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{Binding ExitIp}"
                                   FontFamily="Cascadia Code, Consolas"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tile 2: Exit Node -->
                <Border Grid.Column="2"
                        CornerRadius="14"
                        Background="{StaticResource TileGlassSurface}"
                        BorderBrush="{StaticResource GlassTileEdgeBrush}"
                        BorderThickness="1"
                        Padding="11,9">
                    <StackPanel>
                        <TextBlock Text="EXIT NODE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                        <TextBlock Text="{Binding ExitRoute}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="#C2D2E8"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Tile 3: Latency & Dot -->
                <Border Grid.Column="4"
                        CornerRadius="14"
                        Background="{StaticResource TileGlassSurface}"
                        BorderBrush="{StaticResource GlassTileEdgeBrush}"
                        BorderThickness="1"
                        Padding="11,9">
                    <StackPanel>
                        <TextBlock Text="LATENCY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding PingQualityColor}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding ExitRtt}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. Primary Tactile Glass Action Plate (Connect Button 290px x 62px) -->
            <Grid Grid.Row="2" Margin="0,0,0,14" HorizontalAlignment="Center">
                <Button Style="{StaticResource GlassActionPlateBtn}"
                        Command="{Binding ToggleConnectionCommand}"
                        Width="310"
                        Height="62">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Optical Core Bezel -->
                        <Border Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="#20FFFFFF"
                                BorderBrush="#60FFFFFF"
                                BorderThickness="1"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <Border Width="12" Height="12" CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#38BDF8" />
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#38BDF8" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Hunting}">
                                                <Setter Property="Background" Value="#F59E0B" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#F59E0B" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Connected}">
                                                <Setter Property="Background" Value="#10B981" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#10B981" BlurRadius="12" ShadowDepth="0" Opacity="0.9" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Border>

                        <!-- Title and State Microcopy -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectButtonText}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="13.5"
                                       FontWeight="Heavy"
                                       Foreground="#FFFFFF" />
                            <TextBlock Text="{Binding ConnectButtonSubText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSub}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Right Chevron Lens Indicator -->
                        <Path Grid.Column="2"
                              Data="M 0 0 L 6 6 L 0 12"
                              Stroke="#C2D2E8"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>

            <!-- 3. Dual Routing Switch & Scan Strategy -->
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <!-- Segmented Glass Switch Bar -->
                <Border CornerRadius="13"
                        Background="#121828"
                        BorderBrush="{StaticResource GlassTileEdgeBrush}"
                        BorderThickness="1"
                        Padding="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Option A: System Proxy -->
                        <RadioButton Grid.Column="0"
                                     GroupName="TunnelModeGroup"
                                     IsChecked="{Binding IsSystemProxyMode, Mode=TwoWay}"
                                     IsEnabled="{Binding CanChangeMode}"
                                     Style="{StaticResource LiquidSegmentRadio}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="SYSTEM PROXY" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Option B: True TUN -->
                        <RadioButton Grid.Column="1"
                                     GroupName="TunnelModeGroup"
                                     IsChecked="{Binding IsTrueTunMode, Mode=TwoWay}"
                                     IsEnabled="{Binding CanChangeMode}"
                                     Style="{StaticResource LiquidSegmentRadio}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="TRUE TUN (ALL)" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </Border>

                <!-- Scan Strategy Toggles -->
                <Grid Margin="4,8,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="SCAN STRATEGY"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" />

                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding IsFreshScan, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeMode}"
                              Cursor="Hand">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="CheckBd"
                                            Width="14"
                                            Height="14"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="#354565"
                                            Background="#152035"
                                            Margin="0,0,6,0">
                                        <Path x:Name="CheckMark"
                                              Data="M 2 6 L 5 9 L 10 3"
                                              Stroke="#38BDF8"
                                              StrokeThickness="1.8"
                                              Visibility="Collapsed" />
                                    </Border>
                                    <TextBlock x:Name="CheckLabel"
                                               Text="⚡ Quick Reconnect (Instant)"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSub}" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="CheckBd" Property="BorderBrush" Value="#38BDF8" />
                                        <Setter TargetName="CheckBd" Property="Background" Value="#223555" />
                                        <Setter TargetName="CheckLabel" Property="Text" Value="🔍 Fresh Turbo Scan (2K IPs)" />
                                        <Setter TargetName="CheckLabel" Property="Foreground" Value="#38BDF8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                </Grid>
            </StackPanel>

            <!-- 4. Collapsible Diagnostic Terminal HUD -->
            <Expander Grid.Row="4"
                      IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource TextMuted}">
                <Expander.Header>
                    <Grid Width="384">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="DIAGNOSTIC LOGS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                            <Border Margin="8,0,0,0" Padding="5,1" Background="#1AFFFFFF" CornerRadius="4" BorderBrush="#30FFFFFF" BorderThickness="1">
                                <TextBlock Text="{Binding DiagnosticLogs.Count, StringFormat='{}{0} lines'}" FontSize="8.5" Foreground="#38BDF8" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MiniPillBtn}" Content="Copy" Command="{Binding CopyLogsCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource MiniPillBtn}" Content="Clear" Command="{Binding ClearLogsCommand}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>

                <Border Margin="0,8,0,0"
                        Background="#CC050810"
                        BorderBrush="{StaticResource GlassTileEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10"
                        Height="140">
                    <ListBox x:Name="LogListBox"
                             ItemsSource="{Binding DiagnosticLogs}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#C2D2E8"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" />
                </Border>
            </Expander>

        </Grid>
    </Border>
</Window>
