<Window x:Class="AetherClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AetherClient.Models"
        xmlns:viewmodels="clr-namespace:AetherClient.ViewModels"
        mc:Ignorable="d"
        Title="Aether MASQUE"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Inter, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      CornerRadius="20"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 125-degree Meniscus Razor Specular Brushes -->
        <LinearGradientBrush x:Key="MeniscusEdgeBrush" StartPoint="0.1,0.0" EndPoint="0.9,1.0">
            <GradientStop Color="#E6FFFFFF" Offset="0.0" />
            <GradientStop Color="#24FFFFFF" Offset="0.24" />
            <GradientStop Color="#00FFFFFF" Offset="0.52" />
            <GradientStop Color="#29FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OuterGlassBrush" StartPoint="0.1,0.0" EndPoint="0.9,1.0">
            <GradientStop Color="#24FFFFFF" Offset="0.0" />
            <GradientStop Color="#09FFFFFF" Offset="0.38" />
            <GradientStop Color="#00FFFFFF" Offset="0.62" />
            <GradientStop Color="#0CFFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="EmeraldMeniscusBrush" StartPoint="0.1,0.0" EndPoint="0.9,1.0">
            <GradientStop Color="#F2FFFFFF" Offset="0.0" />
            <GradientStop Color="#8000E676" Offset="0.38" />
            <GradientStop Color="#2900E676" Offset="0.62" />
            <GradientStop Color="#CC00E676" Offset="1.0" />
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="EmeraldPlateBgBrush" Center="0.88,1.08" GradientOrigin="0.88,1.08" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#6600E676" Offset="0.0" />
            <GradientStop Color="#1A00E676" Offset="0.6" />
            <GradientStop Color="#00000000" Offset="1.0" />
        </RadialGradientBrush>

        <!-- Standard Pill Button Style (Copy / Clear) -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#EEF2F8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Button (Min / Close) -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#8C020408" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button (Red hover) -->
        <Style x:Key="CloseControlButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="13"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D9C42B1C" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFEF4444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#80C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drawer Toggle Button -->
        <Style x:Key="DrawerToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Mode Option Button -->
        <Style x:Key="SegmentOptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Frame Container with Padding -->
    <Grid Margin="12">
        <!-- Window Obsidian Floor & Lighting Emitters -->
        <Border CornerRadius="20" Background="#F0080B11">
            <Grid>
                <!-- Cyan Radial Emitter (Top-Right: 88% 10%) -->
                <Ellipse Width="240" Height="170"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-30,-40,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#424CC9F0" Offset="0.0" />
                            <GradientStop Color="#004CC9F0" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Violet Radial Emitter (Bottom-Left: 6% 80%) -->
                <Ellipse Width="280" Height="210"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-60,0,0,-40"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#3DA878FF" Offset="0.0" />
                            <GradientStop Color="#00A878FF" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </Border>

        <!-- Outer Glass Shell (SetProduct 2-Surface Architecture) -->
        <Border CornerRadius="20"
                Background="{StaticResource OuterGlassBrush}"
                BorderBrush="{StaticResource MeniscusEdgeBrush}"
                BorderThickness="1"
                Padding="16,12,16,16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Direction="305" Opacity="0.5" />
            </Border.Effect>

            <StackPanel Orientation="Vertical">
                <!-- 1. Custom TitleBar (Header) -->
                <Grid Height="38" Margin="0,0,0,12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Brand Name -->
                        <TextBlock Text="AETHER"
                                   FontSize="15"
                                   FontWeight="ExtraBold"
                                   Foreground="#EEF2F8"
                                   VerticalAlignment="Center" />

                        <!-- Protocol Badge -->
                        <Border Margin="10,0,0,0"
                                Background="#C704070C"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="MASQUE // H2"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="#A9B6C9"
                                        />
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons (Min / Close) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowControlButtonStyle}"
                                Margin="0,0,6,0"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize to Taskbar">
                            <Path Data="M 3 6 L 9 6"
                                  Stroke="#EEF2F8"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>

                        <Button Style="{StaticResource CloseControlButtonStyle}"
                                Click="HideToTrayButton_Click"
                                ToolTip="Minimize to System Tray">
                            <Path Data="M 3 3 L 9 9 M 9 3 L 3 9"
                                  Stroke="#EEF2F8"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Telemetry Grid (3 Equal Tiles) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Tile 1: Peer IP -->
                    <Border Grid.Column="0"
                            CornerRadius="14"
                            Background="{StaticResource OuterGlassBrush}"
                            BorderBrush="{StaticResource MeniscusEdgeBrush}"
                            BorderThickness="1"
                            Padding="5">
                        <Border CornerRadius="9"
                                Background="#DB04070C"
                                BorderBrush="#0DFFFFFF"
                                BorderThickness="1"
                                Padding="10,10,10,11">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="PEER IP"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#8A9BB2"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding PeerIpValue}"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#EEF2F8"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding PeerIpSub}"
                                           FontSize="10"
                                           Foreground="#8A9BB2"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Tile 2: Exit PoP -->
                    <Border Grid.Column="2"
                            CornerRadius="14"
                            Background="{StaticResource OuterGlassBrush}"
                            BorderBrush="{StaticResource MeniscusEdgeBrush}"
                            BorderThickness="1"
                            Padding="5">
                        <Border CornerRadius="9"
                                Background="#DB04070C"
                                BorderBrush="#0DFFFFFF"
                                BorderThickness="1"
                                Padding="10,10,10,11">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="EXIT POP"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#8A9BB2"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding ExitPopValue}"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#EEF2F8"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ExitPopSub}"
                                           FontSize="10"
                                           Foreground="#8A9BB2"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Tile 3: Ping -->
                    <Border Grid.Column="4"
                            CornerRadius="14"
                            Background="{StaticResource OuterGlassBrush}"
                            BorderBrush="{StaticResource MeniscusEdgeBrush}"
                            BorderThickness="1"
                            Padding="5">
                        <Border CornerRadius="9"
                                Background="#DB04070C"
                                BorderBrush="#0DFFFFFF"
                                BorderThickness="1"
                                Padding="10,10,10,11">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="PING"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#8A9BB2"
                                           Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PingValue}"
                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="#EEF2F8" />
                                    <TextBlock Text=" ms"
                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                               FontSize="11"
                                               Foreground="#8A9BB2"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,2" />
                                    <Ellipse Width="6" Height="6"
                                             Fill="{Binding PingQualityColor}"
                                             VerticalAlignment="Center"
                                             Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding PingSub}"
                                           FontSize="10"
                                           Foreground="#8A9BB2"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- 3. Master Action Zone (Status + 280x56 Connect Plate) -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,4,0,16">
                    <!-- Status Row (Indicator Dot + Status Text) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Grid Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6C7A90">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Connected}">
                                                <Setter Property="Fill" Value="#00E676" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Hunting}">
                                                <Setter Property="Fill" Value="#F2B84B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{Binding StatusDetailText}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#A9B6C9"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Master Action Button (280x56 Optical Glass Plate) -->
                    <Button Width="280" Height="56"
                            Command="{Binding ToggleConnectionCommand}"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="PlateOuter"
                                        CornerRadius="28"
                                        Padding="5"
                                        Background="{StaticResource OuterGlassBrush}"
                                        BorderBrush="{StaticResource MeniscusEdgeBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="PlateShadow"
                                                          Color="#000000"
                                                          BlurRadius="16"
                                                          ShadowDepth="4"
                                                          Opacity="0.4" />
                                    </Border.Effect>

                                    <!-- Inner Stabilized Scrim -->
                                    <Border x:Name="PlateInner"
                                            CornerRadius="23"
                                            Background="#DB04070C"
                                            BorderBrush="#0DFFFFFF"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <!-- Power Icon -->
                                            <Path x:Name="PowerIcon"
                                                  Data="M 10 2 L 10 10 M 4.3 4.8 A 8 8 0 1 0 15.7 4.8"
                                                  Width="20" Height="20"
                                                  Stretch="Uniform"
                                                  Stroke="#EEF2F8"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  VerticalAlignment="Center" />

                                            <!-- Connect Text -->
                                            <TextBlock x:Name="PlateLabel"
                                                       Text="{Binding ConnectButtonText}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#EEF2F8"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <!-- Hunting State -->
                                    <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Hunting}">
                                        <Setter TargetName="PowerIcon" Property="Stroke" Value="#F2B84B" />
                                        <Setter TargetName="PlateLabel" Property="Foreground" Value="#F2B84B" />
                                    </DataTrigger>

                                    <!-- Connected State (Emerald Caustic Glow) -->
                                    <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Connected}">
                                        <Setter TargetName="PlateOuter" Property="Background" Value="{StaticResource EmeraldPlateBgBrush}" />
                                        <Setter TargetName="PlateOuter" Property="BorderBrush" Value="{StaticResource EmeraldMeniscusBrush}" />
                                        <Setter TargetName="PlateShadow" Property="Color" Value="#00E676" />
                                        <Setter TargetName="PlateShadow" Property="BlurRadius" Value="28" />
                                        <Setter TargetName="PlateShadow" Property="Opacity" Value="0.45" />

                                        <Setter TargetName="PlateInner" Property="Background" Value="#F0020605" />
                                        <Setter TargetName="PlateInner" Property="BorderBrush" Value="#4000E676" />
                                        <Setter TargetName="PowerIcon" Property="Stroke" Value="#00E676" />
                                        <Setter TargetName="PlateLabel" Property="Foreground" Value="#00E676" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- 4. Segmented Routing Switch (System Proxy / True TUN) -->
                <Border Height="64"
                        Margin="0,0,0,14"
                        CornerRadius="20"
                        Background="{StaticResource OuterGlassBrush}"
                        BorderBrush="{StaticResource MeniscusEdgeBrush}"
                        BorderThickness="1"
                        Padding="5">
                    <Border CornerRadius="15"
                            Background="#DB04070C"
                            BorderBrush="#0DFFFFFF"
                            BorderThickness="1"
                            Padding="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Option 1: System Proxy -->
                            <Button Grid.Column="0"
                                    Command="{Binding SwitchToSystemProxyCommand}"
                                    IsEnabled="{Binding CanChangeMode}"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="optBd"
                                                            CornerRadius="12"
                                                            Background="Transparent"
                                                            Padding="8,4">
                                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock x:Name="t1" Text="System Proxy" FontSize="13" FontWeight="SemiBold" Foreground="#8A9BB2" HorizontalAlignment="Center" />
                                                            <TextBlock x:Name="t2" Text="127.0.0.1:1820" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="10.5" Foreground="#6C7A90" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSystemProxyMode}" Value="True">
                                                            <Setter TargetName="optBd" Property="Background" Value="#8C141C2A" />
                                                            <Setter TargetName="optBd" Property="BorderBrush" Value="#33FFFFFF" />
                                                            <Setter TargetName="optBd" Property="BorderThickness" Value="1" />
                                                            <Setter TargetName="t1" Property="Foreground" Value="#EEF2F8" />
                                                            <Setter TargetName="t1" Property="FontWeight" Value="Bold" />
                                                            <Setter TargetName="t2" Property="Foreground" Value="#A9B6C9" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Option 2: True TUN -->
                            <Button Grid.Column="1"
                                    Command="{Binding SwitchToTrueTunCommand}"
                                    IsEnabled="{Binding CanChangeMode}"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="optBd"
                                                            CornerRadius="12"
                                                            Background="Transparent"
                                                            Padding="8,4">
                                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock x:Name="t1" Text="True TUN" FontSize="13" FontWeight="SemiBold" Foreground="#8A9BB2" HorizontalAlignment="Center" />
                                                            <TextBlock x:Name="t2" Text="Wintun L3" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="10.5" Foreground="#6C7A90" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsTrueTunMode}" Value="True">
                                                            <Setter TargetName="optBd" Property="Background" Value="#8C141C2A" />
                                                            <Setter TargetName="optBd" Property="BorderBrush" Value="#33FFFFFF" />
                                                            <Setter TargetName="optBd" Property="BorderThickness" Value="1" />
                                                            <Setter TargetName="t1" Property="Foreground" Value="#EEF2F8" />
                                                            <Setter TargetName="t1" Property="FontWeight" Value="Bold" />
                                                            <Setter TargetName="t2" Property="Foreground" Value="#A9B6C9" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Border>

                <!-- 5. Diagnostic Drawer (Collapsible) -->
                <Border CornerRadius="18"
                        Background="{StaticResource OuterGlassBrush}"
                        BorderBrush="{StaticResource MeniscusEdgeBrush}"
                        BorderThickness="1"
                        Padding="5">
                    <Border CornerRadius="13"
                            Background="#DB04070C"
                            BorderBrush="#0DFFFFFF"
                            BorderThickness="1"
                            Padding="12,10">
                        <StackPanel Orientation="Vertical">
                            <!-- Drawer Header (ToggleButton + Copy / Clear) -->
                            <Grid Height="28">
                                <!-- Left: Diagnostics + Count Badge Toggle -->
                                <ToggleButton Style="{StaticResource DrawerToggleButtonStyle}"
                                              IsChecked="{Binding IsLogExpanded}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 2.5 4.5 L 6 8 L 9.5 4.5"
                                              Width="10" Height="8"
                                              Stretch="Uniform"
                                              Stroke="#A9B6C9"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              VerticalAlignment="Center" />

                                        <TextBlock Text="Diagnostics"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#EEF2F8"
                                                   Margin="6,0,8,0"
                                                   VerticalAlignment="Center" />

                                        <Border Background="#26FFFFFF"
                                                CornerRadius="9"
                                                Padding="6,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DiagnosticLogs.Count}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#A9B6C9" />
                                        </Border>
                                    </StackPanel>
                                </ToggleButton>

                                <!-- Right: Copy & Clear Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PillButtonStyle}"
                                            Command="{Binding CopyLogsCommand}"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="Copy" />
                                    </Button>

                                    <Button Style="{StaticResource PillButtonStyle}"
                                            Command="{Binding ClearLogsCommand}">
                                        <TextBlock Text="Clear" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Terminal Console Box -->
                            <Border Margin="0,10,0,0"
                                    Height="135"
                                    CornerRadius="10"
                                    Background="#D9020408"
                                    BorderBrush="#0FFFFFFF"
                                    BorderThickness="1"
                                    Padding="8,6"
                                    Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVis}}">
                                <ListBox x:Name="LogListBox"
                                         ItemsSource="{Binding DiagnosticLogs}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:DiagnosticLogItem}">
                                            <TextBlock FontFamily="Cascadia Mono, Consolas, monospace"
                                                       FontSize="10.5"
                                                       LineHeight="16"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1.5">
                                                <Run Text="{Binding Timestamp, Mode=OneWay}" Foreground="#7F8DA3" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Tag, Mode=OneWay}" Foreground="{Binding TagColor, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Message, Mode=OneWay}" Foreground="#C5CEDB" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
