<Window x:Class="AetherClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AetherClient.ViewModels"
        mc:Ignorable="d"
        Title="Cloudflare WARP (MASQUE Edition) - Marcille Anime Edition"
        Width="960" Height="680"
        MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- COLOR SYSTEM: Marcille Donato (Dungeon Meshi) Warm Anime Fantasy Palette -->
        <Color x:Key="CanvasDarkColor">#090E17</Color>
        <Color x:Key="StageDarkColor">#0E1524</Color>
        <Color x:Key="CardSurfaceColor">#131D30</Color>
        <Color x:Key="CardElevatedColor">#1A273F</Color>

        <!-- Accents -->
        <Color x:Key="TealManaColor">#22B8CF</Color>
        <Color x:Key="CyanGlowColor">#06B6D4</Color>
        <Color x:Key="HearthGoldColor">#FFD166</Color>
        <Color x:Key="AmberWarmColor">#F59E0B</Color>
        <Color x:Key="ConnectedEmeraldColor">#4ADE80</Color>
        <Color x:Key="PepperoniCrimsonColor">#FF5C6A</Color>
        <Color x:Key="BorderSlateColor">#24334D</Color>

        <!-- Solid & Alpha Brushes -->
        <SolidColorBrush x:Key="CanvasDarkBrush" Color="{StaticResource CanvasDarkColor}"/>
        <SolidColorBrush x:Key="StageDarkBrush" Color="{StaticResource StageDarkColor}"/>
        <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}"/>
        <SolidColorBrush x:Key="CardElevatedBrush" Color="{StaticResource CardElevatedColor}"/>
        <SolidColorBrush x:Key="TealManaBrush" Color="{StaticResource TealManaColor}"/>
        <SolidColorBrush x:Key="CyanGlowBrush" Color="{StaticResource CyanGlowColor}"/>
        <SolidColorBrush x:Key="HearthGoldBrush" Color="{StaticResource HearthGoldColor}"/>
        <SolidColorBrush x:Key="AmberWarmBrush" Color="{StaticResource AmberWarmColor}"/>
        <SolidColorBrush x:Key="ConnectedEmeraldBrush" Color="{StaticResource ConnectedEmeraldColor}"/>
        <SolidColorBrush x:Key="PepperoniCrimsonBrush" Color="{StaticResource PepperoniCrimsonColor}"/>
        <SolidColorBrush x:Key="BorderSlateBrush" Color="{StaticResource BorderSlateColor}"/>

        <!-- Text Brushes -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

        <!-- Glow Effects -->
        <DropShadowEffect x:Key="TealGlowEffect" Color="{StaticResource CyanGlowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
        <DropShadowEffect x:Key="GoldGlowEffect" Color="{StaticResource AmberWarmColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
        <DropShadowEffect x:Key="EmeraldGlowEffect" Color="{StaticResource ConnectedEmeraldColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>

        <!-- Button Hover Animations -->
        <Style x:Key="AnimeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WnBorder" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WnBorder" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource WindowControlBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WnCloseBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WnCloseBorder" Property="Background" Value="{StaticResource PepperoniCrimsonBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Frame (With Rounded Outer Glass Border) -->
    <Border CornerRadius="16"
            Background="{StaticResource CanvasDarkBrush}"
            BorderBrush="{StaticResource BorderSlateBrush}"
            BorderThickness="1.2">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left Column: Marcille Anime Art & Mana Aura Stage -->
                <ColumnDefinition Width="340"/>
                <!-- Right Column: Control Deck & Live Telemetry -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- LEFT COLUMN: ANIME HERO SHOWCASE & MANA AURA STAGE        -->
            <!-- ========================================================= -->
            <Border Grid.Column="0"
                    CornerRadius="16,0,0,16"
                    Background="{StaticResource StageDarkBrush}"
                    BorderBrush="{StaticResource BorderSlateBrush}"
                    BorderThickness="0,0,1.2,0">
                <Grid>
                    <!-- Background Ambient Light Vignette -->
                    <Border Background="#06121E" Opacity="0.6"/>

                    <!-- 1. Anime Magic Rune Circles (Behind Character Art) -->
                    <Canvas Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0">
                        <Ellipse Width="300" Height="300"
                                 Stroke="{StaticResource TealManaBrush}"
                                 StrokeThickness="1.2"
                                 StrokeDashArray="8 4 2 4"
                                 Opacity="0.4"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="HeroRuneRotateTransform" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="250" Height="250" Canvas.Left="25" Canvas.Top="25"
                                 Stroke="{StaticResource HearthGoldBrush}"
                                 StrokeThickness="1"
                                 StrokeDashArray="12 6"
                                 Opacity="0.3"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="HeroInnerRuneRotateTransform" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>

                    <Grid Margin="16,20,16,16">
                        <Grid.RowDefinitions>
                            <!-- Character Art Card -->
                            <RowDefinition Height="310"/>
                            <!-- Character Status / Aura Deck -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- HERO ART CARD: Marcille Character Display -->
                        <Border Grid.Row="0"
                                CornerRadius="14"
                                Background="#0A0E17"
                                BorderBrush="{StaticResource BorderSlateBrush}"
                                BorderThickness="1.2"
                                ClipToBounds="True">
                            <Grid>
                                <!-- The Anime Character Image (Loaded safely in C#) -->
                                <Image x:Name="HeroCharacterImage"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                <!-- Bottom Vignette Gradient: Blends Character smoothly into UI card -->
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.0"/>
                                            <GradientStop Color="#00000000" Offset="0.55"/>
                                            <GradientStop Color="#990E1524" Offset="0.82"/>
                                            <GradientStop Color="#FF0E1524" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Top Badges: Japanese Manga Tag & Edition -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
                                    <Border Background="#CC090E17"
                                            BorderBrush="{StaticResource HearthGoldBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,3">
                                        <TextBlock Text="✦ ダンジョン飯 // MARCILLE"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource HearthGoldBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Bottom Overlay in Art Card: Character Name & Mana State -->
                                <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12">
                                    <TextBlock Text="Marcille Donato"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding CompanionSubtitle}"
                                               FontSize="11"
                                               Foreground="{StaticResource TealManaBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- MANA AURA STATUS CARD (Dynamic Animations & Telemetry) -->
                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                CornerRadius="12"
                                Background="{StaticResource CardSurfaceBrush}"
                                BorderBrush="{StaticResource BorderSlateBrush}"
                                BorderThickness="1.2"
                                Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Status Title & State Ring -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Animated Aura Core Ring -->
                                    <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0">
                                        <Ellipse x:Name="AuraOuterRing"
                                                 Width="34" Height="34"
                                                 Stroke="{StaticResource TealManaBrush}"
                                                 StrokeThickness="2"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="AuraScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="AuraDropShadow" Color="{StaticResource CyanGlowColor}" BlurRadius="12" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <!-- Inner Radar Sweep -->
                                        <Ellipse x:Name="RadarSweepEllipse"
                                                 Width="24" Height="24"
                                                 Stroke="{StaticResource HearthGoldBrush}"
                                                 StrokeThickness="1.5"
                                                 StrokeDashArray="3 3"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="RadarRotateTransform" Angle="0"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Status Title Text -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompanionStatusTitle}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource HearthGoldBrush}"/>
                                    </StackPanel>

                                    <!-- Equalizer Bars for Connected State -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="16">
                                        <Border x:Name="EqBar1" Width="3" Height="6" Margin="1,0" Background="{StaticResource ConnectedEmeraldBrush}" CornerRadius="1.5" VerticalAlignment="Bottom"/>
                                        <Border x:Name="EqBar2" Width="3" Height="12" Margin="1,0" Background="{StaticResource ConnectedEmeraldBrush}" CornerRadius="1.5" VerticalAlignment="Bottom"/>
                                        <Border x:Name="EqBar3" Width="3" Height="8" Margin="1,0" Background="{StaticResource ConnectedEmeraldBrush}" CornerRadius="1.5" VerticalAlignment="Bottom"/>
                                        <Border x:Name="EqBar4" Width="3" Height="14" Margin="1,0" Background="{StaticResource ConnectedEmeraldBrush}" CornerRadius="1.5" VerticalAlignment="Bottom"/>
                                        <Border x:Name="EqBar5" Width="3" Height="5" Margin="1,0" Background="{StaticResource ConnectedEmeraldBrush}" CornerRadius="1.5" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Aura Description Text -->
                                <TextBlock Grid.Row="1"
                                           Margin="0,8,0,8"
                                           Text="{Binding CompanionAuraDescription}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="15"/>

                                <!-- Routing Protocol Badge -->
                                <Border Grid.Row="2"
                                        VerticalAlignment="Bottom"
                                        Background="#0A0E17"
                                        BorderBrush="{StaticResource BorderSlateBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,5">
                                    <TextBlock Text="{Binding ActiveRoutingDescription}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- RIGHT COLUMN: CONTROL DECK, TELEMETRY & TERMINAL CONSOLE  -->
            <!-- ========================================================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Row 0: Custom Window Title Bar -->
                    <RowDefinition Height="46"/>
                    <!-- Row 1: Mode Switcher & Primary Action Deck -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Gateway Telemetry Metric Cards -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Terminal Console -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: WINDOW TITLE BAR (Draggable) -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        Padding="16,0,10,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CLOUDFLARE WARP"
                                       FontSize="13"
                                       FontWeight="Black"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0"
                                    Background="#2206B6D4"
                                    BorderBrush="{StaticResource TealManaBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2">
                                <TextBlock Text="MASQUE RFC 9298"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TealManaBrush}"/>
                            </Border>
                            <Border Margin="6,0,0,0"
                                    Background="#22FFD166"
                                    BorderBrush="{StaticResource HearthGoldBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2">
                                <TextBlock Text="エルフの魔力 // TURBO MESH"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource HearthGoldBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Window Control Buttons (Minimize & Close) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource WindowControlBtnStyle}" Click="MinimizeButton_Click">
                                <TextBlock Text="—" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource WindowCloseBtnStyle}" Click="CloseButton_Click" Margin="4,0,0,0">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 1: MODE SWITCHERS & PRIMARY ACTION DECK -->
                <Border Grid.Row="1"
                        Margin="16,0,16,10"
                        Background="{StaticResource CardSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSlateBrush}"
                        BorderThickness="1.2"
                        CornerRadius="12"
                        Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Mode Toggle Selector Pills -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- True TUN Toggle Button -->
                            <RadioButton Grid.Column="0"
                                         Margin="0,0,5,0"
                                         IsChecked="{Binding IsTunModeSelected, Mode=TwoWay}"
                                         GroupName="ProxyModeSelection"
                                         Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="PillBorder"
                                                Background="#0F172A"
                                                BorderBrush="{StaticResource BorderSlateBrush}"
                                                BorderThickness="1.2"
                                                CornerRadius="8"
                                                Padding="10,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="🛡️" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="True TUN (Wintun L3)"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="PillBorder" Property="Background" Value="#2206B6D4"/>
                                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource TealManaBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- System Proxy Toggle Button -->
                            <RadioButton Grid.Column="1"
                                         Margin="5,0,0,0"
                                         IsChecked="{Binding IsSystemProxySelected, Mode=TwoWay}"
                                         GroupName="ProxyModeSelection"
                                         Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="PillBorder"
                                                Background="#0F172A"
                                                BorderBrush="{StaticResource BorderSlateBrush}"
                                                BorderThickness="1.2"
                                                CornerRadius="8"
                                                Padding="10,8">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="🌐" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="System Proxy (1820)"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="PillBorder" Property="Background" Value="#22FFD166"/>
                                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource HearthGoldBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </Grid>

                        <!-- Bottom: Action Buttons (Engage Masque + Hunt Next Edge) -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Primary Action Button: Engage Link -->
                            <Button Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Height="42"
                                    Style="{StaticResource AnimeButtonStyle}"
                                    Background="{StaticResource TealManaBrush}"
                                    BorderThickness="0"
                                    Command="{Binding ToggleTunnelCommand}"
                                    Effect="{StaticResource TealGlowEffect}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PrimaryActionButtonText}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#090E17"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Re-Scan / Hunt Next Edge Button -->
                            <Button Grid.Column="1"
                                    Height="42"
                                    Style="{StaticResource AnimeButtonStyle}"
                                    Background="{StaticResource CardElevatedBrush}"
                                    BorderBrush="{StaticResource HearthGoldBrush}"
                                    BorderThickness="1.2"
                                    Command="{Binding HuntNextEdgeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Hunt Edge"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource HearthGoldBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ROW 2: ACTIVE GATEWAY TELEMETRY METRIC CARDS -->
                <Grid Grid.Row="2" Margin="16,0,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Metric 1: Status -->
                    <Border Grid.Column="0"
                            Margin="0,0,4,0"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSlateBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding StatusBadgeText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TealManaBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Metric 2: Gateway Peer -->
                    <Border Grid.Column="1"
                            Margin="4,0,4,0"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSlateBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="GATEWAY PEER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding GatewayPeer}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Metric 3: Datacenter Route -->
                    <Border Grid.Column="2"
                            Margin="4,0,4,0"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSlateBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="EXIT ROUTE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding RouteDatacenter}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource HearthGoldBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Metric 4: Latency RTT -->
                    <Border Grid.Column="3"
                            Margin="4,0,0,0"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSlateBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="LATENCY RTT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding LatencyRtt}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ConnectedEmeraldBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ROW 3: LIVE TERMINAL TELEMETRY CONSOLE -->
                <Border Grid.Row="3"
                        Margin="16,0,16,16"
                        Background="#080C14"
                        BorderBrush="{StaticResource BorderSlateBrush}"
                        BorderThickness="1.2"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Terminal Header -->
                            <RowDefinition Height="34"/>
                            <!-- Terminal Monospace Log List -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Terminal Header Bar -->
                        <Border Grid.Row="0"
                                Background="#0D1420"
                                BorderBrush="{StaticResource BorderSlateBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="10,10,0,0"
                                Padding="12,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="• TERMINAL TELEMETRY"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Margin="8,0,0,0"
                                            Background="#1E293B"
                                            CornerRadius="4"
                                            Padding="6,1">
                                        <TextBlock Text="{Binding LogCountBadgeText}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource HearthGoldBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Action Buttons: Copy Logs & Clear -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Height="22"
                                            Padding="8,0"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource AnimeButtonStyle}"
                                            Background="#1E293B"
                                            BorderThickness="0"
                                            Command="{Binding CopyLogsCommand}">
                                        <TextBlock Text="{Binding CopyButtonText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TealManaBrush}"/>
                                    </Button>
                                    <Button Height="22"
                                            Padding="8,0"
                                            Style="{StaticResource AnimeButtonStyle}"
                                            Background="#1E293B"
                                            BorderThickness="0"
                                            Command="{Binding ClearLogsCommand}">
                                        <TextBlock Text="Clear"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Terminal Log Stream -->
                        <ListBox Grid.Row="1"
                                 x:Name="TelemetryLogListBox"
                                 ItemsSource="{Binding Logs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,2"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Timestamp}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Tag}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding TagBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{Binding MessageBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
