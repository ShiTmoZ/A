<Window x:Class="AetherClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AetherClient.ViewModels"
        mc:Ignorable="d"
        Title="Cloudflare WARP (MASQUE Edition) - Fluent Cyber Edition"
        Width="960" Height="650"
        MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- COLOR SYSTEM: Obsidian Fluent Cyber-Glass -->
        <Color x:Key="CanvasDarkColor">#090C15</Color>
        <Color x:Key="CardSurfaceColor">#101626</Color>
        <Color x:Key="CardElevatedColor">#162035</Color>
        <Color x:Key="BorderSubtleColor">#1D2A42</Color>
        <Color x:Key="BorderGlassColor">#2A3C5E</Color>

        <!-- Accents -->
        <Color x:Key="CyberCyanColor">#00D2FF</Color>
        <Color x:Key="CyberIndigoColor">#6366F1</Color>
        <Color x:Key="CyberVioletColor">#8B5CF6</Color>
        <Color x:Key="ConnectedEmeraldColor">#10B981</Color>
        <Color x:Key="AmberRadarColor">#F59E0B</Color>
        <Color x:Key="AlertCrimsonColor">#EF4444</Color>

        <!-- Solid Brushes -->
        <SolidColorBrush x:Key="CanvasDarkBrush" Color="{StaticResource CanvasDarkColor}"/>
        <SolidColorBrush x:Key="CardSurfaceBrush" Color="{StaticResource CardSurfaceColor}"/>
        <SolidColorBrush x:Key="CardElevatedBrush" Color="{StaticResource CardElevatedColor}"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
        <SolidColorBrush x:Key="BorderGlassBrush" Color="{StaticResource BorderGlassColor}"/>
        <SolidColorBrush x:Key="CyberCyanBrush" Color="{StaticResource CyberCyanColor}"/>
        <SolidColorBrush x:Key="CyberIndigoBrush" Color="{StaticResource CyberIndigoColor}"/>
        <SolidColorBrush x:Key="CyberVioletBrush" Color="{StaticResource CyberVioletColor}"/>
        <SolidColorBrush x:Key="ConnectedEmeraldBrush" Color="{StaticResource ConnectedEmeraldColor}"/>
        <SolidColorBrush x:Key="AmberRadarBrush" Color="{StaticResource AmberRadarColor}"/>
        <SolidColorBrush x:Key="AlertCrimsonBrush" Color="{StaticResource AlertCrimsonColor}"/>

        <!-- Text Brushes -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

        <!-- Glow Effects -->
        <DropShadowEffect x:Key="CyanGlowEffect" Color="{StaticResource CyberCyanColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
        <DropShadowEffect x:Key="EmeraldGlowEffect" Color="{StaticResource ConnectedEmeraldColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
        <DropShadowEffect x:Key="AmberGlowEffect" Color="{StaticResource AmberRadarColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>

        <!-- Button Style -->
        <Style x:Key="FluentButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Control Buttons -->
        <Style x:Key="WindowControlBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WnBorder" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="WnBorder" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource WindowControlBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="WnCloseBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WnCloseBorder" Property="Background" Value="{StaticResource AlertCrimsonBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Frame with Fluent Cyber Glass Border -->
    <Border CornerRadius="14"
            BorderBrush="{StaticResource BorderGlassBrush}"
            BorderThickness="1.2">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#090C15" Offset="0.0" />
                <GradientStop Color="#0E1322" Offset="0.5" />
                <GradientStop Color="#141C30" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Custom Window Title Bar -->
                <RowDefinition Height="46"/>
                <!-- Row 1: Telemetry Metric Cards Strip (HUD) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Main Workspace (Control Deck + Terminal) -->
                <RowDefinition Height="*"/>
                <!-- Row 3: Bottom Status Bar -->
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- ROW 0: WINDOW TITLE BAR (Draggable)                       -->
            <!-- ========================================================= -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    Padding="16,0,12,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Brand Geometric Shield -->
                        <Path Data="M12,2L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,2Z"
                              Fill="{StaticResource CyberCyanBrush}"
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Margin="0,0,10,0"/>

                        <TextBlock Text="CLOUDFLARE WARP"
                                   FontSize="13"
                                   FontWeight="Black"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>

                        <Border Margin="10,0,0,0"
                                Background="#1A00D2FF"
                                BorderBrush="{StaticResource CyberCyanBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2">
                            <TextBlock Text="MASQUE RFC 9298"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyberCyanBrush}"/>
                        </Border>

                        <Border Margin="6,0,0,0"
                                Background="#1A6366F1"
                                BorderBrush="{StaticResource CyberIndigoBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2">
                            <TextBlock Text="FLUENT CYBER EDITION"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CyberIndigoBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Active CLI Command Preview Pill -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#090E18"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,3"
                            MaxWidth="400">
                        <TextBlock Text="{Binding LastExecutedCommand}"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Window Control Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource WindowControlBtnStyle}" Click="MinimizeButton_Click">
                            <TextBlock Text="—" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseBtnStyle}" Click="CloseButton_Click" Margin="4,0,0,0">
                            <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- ROW 1: TELEMETRY METRIC HUD STRIP                         -->
            <!-- ========================================================= -->
            <Grid Grid.Row="1" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Metric 1: Status -->
                <Border Grid.Column="0"
                        Margin="0,0,5,0"
                        Background="{StaticResource CardSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Glowing Status Ring -->
                        <Grid Grid.Column="0" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse x:Name="AuraOuterRing"
                                     Width="24" Height="24"
                                     Stroke="{StaticResource CyberCyanBrush}"
                                     StrokeThickness="2"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="AuraScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="AuraDropShadow" Color="{StaticResource CyberCyanColor}" BlurRadius="12" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="RadarSweepEllipse"
                                     Width="14" Height="14"
                                     Stroke="{StaticResource AmberRadarBrush}"
                                     StrokeThickness="1.5"
                                     StrokeDashArray="2 2"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="RadarRotateTransform" Angle="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TUNNEL STATE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding StatusBadgeText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyberCyanBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metric 2: Gateway Peer -->
                <Border Grid.Column="1"
                        Margin="5,0,5,0"
                        Background="{StaticResource CardSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GATEWAY PEER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding GatewayPeer}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Metric 3: Datacenter Route -->
                <Border Grid.Column="2"
                        Margin="5,0,5,0"
                        Background="{StaticResource CardSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="EXIT LOCATION / ROUTE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding RouteDatacenter}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AmberRadarBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Metric 4: Mesh Latency RTT -->
                <Border Grid.Column="3"
                        Margin="5,0,0,0"
                        Background="{StaticResource CardSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MESH RTT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding LatencyRtt}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ConnectedEmeraldBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- ROW 2: MAIN WORKSPACE (CONTROL DECK + TERMINAL)           -->
            <!-- ========================================================= -->
            <Grid Grid.Row="2" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <!-- Left: Control Deck (Width 360) -->
                    <ColumnDefinition Width="360"/>
                    <!-- Gap -->
                    <ColumnDefinition Width="14"/>
                    <!-- Right: Terminal Telemetry Console (Width *) -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ========================================================= -->
                <!-- LEFT COLUMN: CONTROL DECK                                 -->
                <!-- ========================================================= -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <!-- Location & Exit Profile -->
                        <RowDefinition Height="Auto"/>
                        <!-- Routing Architecture -->
                        <RowDefinition Height="Auto"/>
                        <!-- Action Buttons -->
                        <RowDefinition Height="Auto"/>
                        <!-- Security Telemetry Card -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- CARD 1: EXIT LOCATION & GEO FILTER -->
                    <Border Grid.Row="0"
                            Margin="0,0,0,10"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1.2"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🌐" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="EXIT LOCATION &amp; GEO FILTER"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Option 1: Auto Anycast -->
                            <RadioButton Margin="0,0,0,6"
                                         IsChecked="{Binding IsAutoAnycast, Mode=TwoWay}"
                                         GroupName="ExitLocationSelection"
                                         Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="OptBorder"
                                                Background="#0C1220"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="⚡ Auto Anycast"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Lowest RTT Cloudflare edge mesh"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="#1A00D2FF"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="FASTEST" FontSize="8" FontWeight="Bold" Foreground="{StaticResource CyberCyanBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="OptBorder" Property="Background" Value="#1A00D2FF"/>
                                                <Setter TargetName="OptBorder" Property="BorderBrush" Value="{StaticResource CyberCyanBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- Option 2: Bypass Iran -->
                            <RadioButton Margin="0,0,0,6"
                                         IsChecked="{Binding IsBypassIran, Mode=TwoWay}"
                                         GroupName="ExitLocationSelection"
                                         Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="OptBorder"
                                                Background="#0C1220"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="🌍 Bypass Iran (--exit-loc !IR)"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Rejects Iranian geo-mapped exit nodes"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="#1AF59E0B"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="GEO SAFE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AmberRadarBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="OptBorder" Property="Background" Value="#1AF59E0B"/>
                                                <Setter TargetName="OptBorder" Property="BorderBrush" Value="{StaticResource AmberRadarBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <!-- Option 3: Europe Direct -->
                            <RadioButton Margin="0"
                                         IsChecked="{Binding IsEuropeanTunnel, Mode=TwoWay}"
                                         GroupName="ExitLocationSelection"
                                         Cursor="Hand">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="OptBorder"
                                                Background="#0C1220"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="🇪🇺 Europe Direct (--mim)"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="Dual-hop MASQUE tunnel to Frankfurt / AMS"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="#1A8B5CF6"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="NESTED" FontSize="8" FontWeight="Bold" Foreground="{StaticResource CyberVioletBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="OptBorder" Property="Background" Value="#1A8B5CF6"/>
                                                <Setter TargetName="OptBorder" Property="BorderBrush" Value="{StaticResource CyberVioletBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: ROUTING ENGINE -->
                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1.2"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🛡️" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="ROUTING ENGINE"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- True TUN Radio -->
                                <RadioButton Grid.Column="0"
                                             Margin="0,0,4,0"
                                             IsChecked="{Binding IsTunModeSelected, Mode=TwoWay}"
                                             GroupName="ProxyModeSelection"
                                             Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="PillBorder"
                                                    Background="#0C1220"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="8,7">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="🛡️" FontSize="11" Margin="0,0,5,0"/>
                                                    <TextBlock Text="True TUN (L3)"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="PillBorder" Property="Background" Value="#1A00D2FF"/>
                                                    <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource CyberCyanBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>

                                <!-- System Proxy Radio -->
                                <RadioButton Grid.Column="1"
                                             Margin="4,0,0,0"
                                             IsChecked="{Binding IsSystemProxySelected, Mode=TwoWay}"
                                             GroupName="ProxyModeSelection"
                                             Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="PillBorder"
                                                    Background="#0C1220"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="8,7">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="🌐" FontSize="11" Margin="0,0,5,0"/>
                                                    <TextBlock Text="System Proxy"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="PillBorder" Property="Background" Value="#1A6366F1"/>
                                                    <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource CyberIndigoBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </Grid>

                            <TextBlock Text="{Binding ActiveRoutingDescription}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,7,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: ACTION BUTTONS -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Primary Toggle Action Button -->
                        <Button Grid.Column="0"
                                Margin="0,0,8,0"
                                Height="42"
                                Style="{StaticResource FluentButtonStyle}"
                                Background="{StaticResource CyberCyanBrush}"
                                BorderThickness="0"
                                Command="{Binding ToggleTunnelCommand}"
                                Effect="{StaticResource CyanGlowEffect}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PrimaryActionButtonText}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#090C15"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Secondary Re-Hunt Edge Button -->
                        <Button Grid.Column="1"
                                Height="42"
                                Style="{StaticResource FluentButtonStyle}"
                                Background="{StaticResource CardElevatedBrush}"
                                BorderBrush="{StaticResource AmberRadarBrush}"
                                BorderThickness="1.2"
                                Command="{Binding HuntNextEdgeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hunt Edge"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AmberRadarBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- CARD 4: SECURITY & INTEGRITY MINI-HUD -->
                    <Border Grid.Row="3"
                            Background="{StaticResource CardSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="SECURITY &amp; PROCESS INTEGRITY"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="DNS Spoof Shield" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="LOCKED 1.1.1.1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ConnectedEmeraldBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="DPI Resistance" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="HTTP/2 CONNECT-IP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyberCyanBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Process Guardian" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="JOB OBJECT ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyberIndigoBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================================================= -->
                <!-- RIGHT COLUMN: LIVE TERMINAL TELEMETRY CONSOLE             -->
                <!-- ========================================================= -->
                <Border Grid.Column="2"
                        Background="#070A12"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1.2"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Terminal Header -->
                            <RowDefinition Height="36"/>
                            <!-- Terminal Monospace Log Stream -->
                            <RowDefinition Height="*"/>
                            <!-- Terminal Footer Endpoints -->
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>

                        <!-- Terminal Header Bar -->
                        <Border Grid.Row="0"
                                Background="#0D1322"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="10,10,0,0"
                                Padding="12,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="• LIVE TELEMETRY STREAM"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border Margin="8,0,0,0"
                                            Background="#1E293B"
                                            CornerRadius="4"
                                            Padding="6,1">
                                        <TextBlock Text="{Binding LogCountBadgeText}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AmberRadarBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Action Buttons: Copy Logs & Clear -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Height="22"
                                            Padding="8,0"
                                            Margin="0,0,6,0"
                                            Style="{StaticResource FluentButtonStyle}"
                                            Background="#1E293B"
                                            BorderThickness="0"
                                            Command="{Binding CopyLogsCommand}">
                                        <TextBlock Text="{Binding CopyButtonText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource CyberCyanBrush}"/>
                                    </Button>
                                    <Button Height="22"
                                            Padding="8,0"
                                            Style="{StaticResource FluentButtonStyle}"
                                            Background="#1E293B"
                                            BorderThickness="0"
                                            Command="{Binding ClearLogsCommand}">
                                        <TextBlock Text="Clear"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Terminal Monospace Log Stream -->
                        <ListBox Grid.Row="1"
                                 x:Name="TelemetryLogListBox"
                                 ItemsSource="{Binding Logs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="10,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,2"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Timestamp}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="#64748B"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Tag}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding TagBrush}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{Binding MessageBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Terminal Footer Endpoints -->
                        <Border Grid.Row="2"
                                Background="#0A0E18"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10"
                                Padding="10,0">
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="{Binding LocalListeners}"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="RFC 9298 MASQUE"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CyberCyanBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================= -->
            <!-- ROW 3: BOTTOM STATUS BAR                                  -->
            <!-- ========================================================= -->
            <Border Grid.Row="3"
                    Background="#070911"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="AETHER CORE v2.4.0 • Zero-Leak Wintun L3 • Clean IP Management"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="DNS: 1.1.1.1 [Strict Netsh Clamped]"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ConnectedEmeraldBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
