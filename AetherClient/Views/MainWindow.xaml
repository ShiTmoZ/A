<Window x:Class="AetherClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AetherClient.Models"
        mc:Ignorable="d"
        Title="Aether Client"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0F1117"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="12"
                      GlassFrameThickness="1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Solid Brushes -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0F1117" />
        <SolidColorBrush x:Key="BgSurface" Color="#161922" />
        <SolidColorBrush x:Key="BgElevated" Color="#1E2330" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#262C3A" />
        <SolidColorBrush x:Key="AccentSky" Color="#38BDF8" />
        <SolidColorBrush x:Key="StateAmber" Color="#F59E0B" />
        <SolidColorBrush x:Key="StateSlate" Color="#64748B" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />

        <!-- Window Chrome Button Style -->
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2330" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mode Selector Radio Card Style -->
        <Style x:Key="ModeCardRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#161922" />
            <Setter Property="BorderBrush" Value="#262C3A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" />
                                <Ellipse x:Name="IndicatorDot"
                                         Grid.Column="1"
                                         Width="10"
                                         Height="10"
                                         VerticalAlignment="Top"
                                         Stroke="#64748B"
                                         StrokeThickness="1.5"
                                         Fill="Transparent" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#1B202C" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="CardBorder" Property="Background" Value="#142030" />
                                <Setter TargetName="IndicatorDot" Property="Fill" Value="#38BDF8" />
                                <Setter TargetName="IndicatorDot" Property="Stroke" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Action Button Style -->
        <Style x:Key="MiniActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E2330" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="#262C3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#262C3A" BorderThickness="1" Background="#0F1117">
        <Grid Margin="20,8,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Custom Header Bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#38BDF8" Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#38BDF8" BlurRadius="10" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="AETHER" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" />
                    <TextBlock Text="MASQUE // H2" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="8,1,0,0" />
                </StackPanel>

                <!-- Real-Time State Badge -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="12"
                        Padding="10,3"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#161922" />
                            <Setter Property="BorderBrush" Value="#262C3A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Hunting}">
                                    <Setter Property="Background" Value="#271E12" />
                                    <Setter Property="BorderBrush" Value="#F59E0B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Connected}">
                                    <Setter Property="Background" Value="#102637" />
                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#64748B" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Hunting}">
                                            <Setter Property="Fill" Value="#F59E0B" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Connected}">
                                            <Setter Property="Fill" Value="#38BDF8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StateBadgeText}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Hunting}">
                                            <Setter Property="Foreground" Value="#FBBF24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Connected}">
                                            <Setter Property="Foreground" Value="#38BDF8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize">
                        <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Click="HideToTrayButton_Click"
                            ToolTip="Minimize to System Tray">
                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Prominent Connect / Disconnect Orb & Status -->
            <Border Grid.Row="1"
                    Background="#161922"
                    BorderBrush="#262C3A"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20,24"
                    Margin="0,14,0,14">
                <StackPanel HorizontalAlignment="Center">
                    <Button Command="{Binding ToggleConnectionCommand}"
                            Cursor="Hand"
                            Width="132"
                            Height="132"
                            HorizontalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Outer Glow Ring -->
                                    <Ellipse x:Name="OuterRing"
                                             StrokeThickness="2.5"
                                             Stroke="#262C3A"
                                             Fill="#0F1117">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#38BDF8" BlurRadius="28" ShadowDepth="0" Opacity="0" />
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <!-- Center Power Icon & Label -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path x:Name="PowerGlyph"
                                              Data="M 12,2 L 12,12 M 6.34,4.34 A 8,8 0 1 0 17.66,4.34"
                                              Stroke="#94A3B8"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding ConnectButtonText}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#F8FAFC"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterRing" Property="Stroke" Value="#38BDF8" />
                                        <Setter TargetName="PowerGlyph" Property="Stroke" Value="#F8FAFC" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Hunting}">
                                        <Setter TargetName="OuterRing" Property="Stroke" Value="#F59E0B" />
                                        <Setter TargetName="PowerGlyph" Property="Stroke" Value="#F59E0B" />
                                        <Setter TargetName="OuterRing" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#F59E0B" BlurRadius="28" ShadowDepth="0" Opacity="0.35" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentState}" Value="{x:Static models:ConnectionState.Connected}">
                                        <Setter TargetName="OuterRing" Property="Stroke" Value="#38BDF8" />
                                        <Setter TargetName="PowerGlyph" Property="Stroke" Value="#38BDF8" />
                                        <Setter TargetName="OuterRing" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#38BDF8" BlurRadius="28" ShadowDepth="0" Opacity="0.45" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="{Binding ConnectButtonSubText}"
                               FontSize="12"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- 3. Dual Tunnel Mode Selector (Mode A vs Mode B) -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Mode A: System Proxy -->
                <RadioButton Grid.Column="0"
                             Style="{StaticResource ModeCardRadioStyle}"
                             IsChecked="{Binding IsSystemProxyMode, Mode=TwoWay}"
                             IsEnabled="{Binding CanChangeMode}">
                    <StackPanel>
                        <TextBlock Text="System Proxy" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" />
                        <TextBlock Text="WinINET HKCU API" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0" />
                        <TextBlock Text="Browsers &amp; HTTP apps" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </RadioButton>

                <!-- Mode B: True TUN Adapter -->
                <RadioButton Grid.Column="2"
                             Style="{StaticResource ModeCardRadioStyle}"
                             IsChecked="{Binding IsTrueTunMode, Mode=TwoWay}"
                             IsEnabled="{Binding CanChangeMode}">
                    <StackPanel>
                        <TextBlock Text="True TUN Adapter" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" />
                        <TextBlock Text="Aether-Tun (Wintun)" FontSize="11" Foreground="#38BDF8" Margin="0,3,0,0" />
                        <TextBlock Text="All system &amp; game traffic" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!-- 4. Telemetry Readout Cards (masque exit: <ip>, <route>, <rtt>) -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#161922" BorderBrush="#262C3A" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="EXIT NODE IP" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="{Binding ExitIp}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#161922" BorderBrush="#262C3A" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="ROUTE" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="{Binding ExitRoute}" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="#161922" BorderBrush="#262C3A" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="LATENCY" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                        <TextBlock Text="{Binding ExitRtt}" FontSize="13" FontWeight="SemiBold" Foreground="#10B981" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Collapsible Live Diagnostic Terminal Log -->
            <Border Grid.Row="4"
                    Background="#161922"
                    BorderBrush="#262C3A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10">
                <Expander IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}"
                          Foreground="#94A3B8"
                          BorderThickness="0">
                    <Expander.Header>
                        <Grid Width="345">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="LIVE DIAGNOSTIC TERMINAL"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Content="Copy"
                                        Command="{Binding CopyLogsCommand}"
                                        Margin="0,0,6,0" />
                                <Button Style="{StaticResource MiniActionButtonStyle}"
                                        Content="Clear"
                                        Command="{Binding ClearLogsCommand}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Border Background="#0B0D12"
                            BorderBrush="#1E2330"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,10,0,0"
                            Height="170">
                        <ListBox x:Name="LogListBox"
                                 ItemsSource="{Binding DiagnosticLogs}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#CBD5E1"
                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                 FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" />
                    </Border>
                </Expander>
            </Border>
        </Grid>
    </Border>
</Window>
